litematica.hover.area_editor.multi_region.selection_box.pos1=Esquina 1: x: §9%s§r, y: §9%s§r, z: §9%s§r
litematica.hover.area_editor.multi_region.selection_box.pos2=Esquina 2: x: §9%s§r, y: §9%s§r, z: §9%s§r
