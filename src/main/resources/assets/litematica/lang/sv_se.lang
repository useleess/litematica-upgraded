litematica.config.name.showextraschematictypes=Visa extra schematyper
litematica.config.name.showhelpfulreminders=Visa hjälpsamma påminnelser
litematica.config.name.shownewuserextranags=Visa extra påminnelser för nya användare
litematica.config.name.showreminderdisable=Visa påminnelse om inaktivering
litematica.config.name.signtextpaste=Inklistring av skylttext
litematica.config.name.toolitem=Verktygsföremål
litematica.config.name.toolitemenabled=Verktygsföremålets funktion
litematica.config.name.toolselectionmode=Verktygets markeringsläge
