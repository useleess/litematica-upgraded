litematica.config.name.fixrailrotation=Fixa rotation av rails
litematica.config.name.generatelowercasenames=Generera namn med gemener
litematica.config.name.loadentireschematics=Ladda hela scheman
litematica.config.name.materiallistignoreblockstate=Materiallista ignorerar blocktillstånd
litematica.config.name.materiallistfromcontainer=Materiallista från behållare
